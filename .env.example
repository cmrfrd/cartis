# Cartis local settings — this file is gitignored; never commit real tokens.
# Restart `bun run dev` after changing values.

# Real AI portrait generation via Replicate (flux-kontext-pro).
# Get a token at https://replicate.com (Account settings -> API tokens).
# Without it, the offline stub stylizer is used and photos never leave this machine.
# REPLICATE_API_TOKEN=r8_your_token_here

# Chat + art-prompt agent (pi, in-process). One of these keys is required
# for the chat panel; without either, chat turns fail with a clear note.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Pin the agent's model as provider/model-id (optional).
# CARTIS_MODEL=anthropic/claude-sonnet-4-6
